# 엔진 검사용 고정물 -- 진단 원뿔 · 다중 고장 · τ 중재 · 컴파일러 거부를 붙들려고 둔다. 제품의 모형이 아니다.

SYMBOL C01 CAMERA;   SYMBOL C02 RADAR;   SYMBOL C03 GPS;   SYMBOL C04 BATTERY;
SYMBOL C05 POWER_BUS; SYMBOL C06 DATA_BUS; SYMBOL C07 LENS; SYMBOL C08 ENV_VIS;
SYMBOL F01 CAM_POWER_LOSS;  SYMBOL F02 CAM_DATA_DROP;  SYMBOL F03 LENS_OBSCURED;
SYMBOL F04 VIS_SMOKE;  SYMBOL F05 BUS_UNDERVOLT;  SYMBOL F06 RADAR_FAIL;  SYMBOL F07 GPS_DENIED;

OBSERVE S10 CAM_FRAMES_STALE = camera.frame_age_ms > 500;
OBSERVE S11 CAM_QUALITY_LOW  = camera.contrast < 0.15 FOR 3 TICKS;
OBSERVE S12 BUS_V_LOW        = power.bus_v < 11.0;
OBSERVE S13 DATA_CRC_ERR     = camera.crc_err_rate > 0.01;
OBSERVE S14 RADAR_OK         = radar.health == 1;
OBSERVE S15 RADAR_CONTACT    = radar.n_contacts > 0;
OBSERVE S16 TARGET_NEAR      = radar.nearest_m < 2.0;
OBSERVE S18 COLOR_BLUE_SEEN  = camera.blue_score > 0.8;
OBSERVE S19 GPS_FIX          = gps.fix == 1;
OBSERVE S20 BATTERY_LOW      = battery.margin_to_home < 0;
OBSERVE S21 HAZARD_AHEAD     = radar.obstacle_m < 0.5;
PRIOR   S22 SMOKE_PRIOR      = MISSION.ENV == SMOKE;

COMPONENT C05 POWER_BUS { MODES NOMINAL PRIOR 0, F05 PRIOR 2;
                          OBSERVED_BY S12;  PREDICT NOMINAL: !S12;  PREDICT F05: S12; }
COMPONENT C06 DATA_BUS  { MODES NOMINAL PRIOR 0, F02 PRIOR 2;
                          OBSERVED_BY S13;  PREDICT NOMINAL: !S13;  PREDICT F02: S13; }
COMPONENT C07 LENS      { MODES NOMINAL PRIOR 0, F03 PRIOR 3; }
COMPONENT C08 ENV_VIS   { MODES NOMINAL PRIOR 1, F04 PRIOR 1; OBSERVED_BY S22; PREDICT F04: S22; }
COMPONENT C01 CAMERA {
    MODES NOMINAL PRIOR 0, F01 PRIOR 2;
    DEPENDS ON C05, C06, C07, C08;
    OBSERVED_BY S10, S11;
    PREDICT NOMINAL: !S10 & !S11;
    PREDICT F01: S10;
}
COMPONENT C02 RADAR   { MODES NOMINAL PRIOR 0, F06 PRIOR 3; DEPENDS ON C05; OBSERVED_BY S14;
                        PREDICT NOMINAL: S14;  PREDICT F06: !S14; }
COMPONENT C03 GPS     { MODES NOMINAL PRIOR 0, F07 PRIOR 1; OBSERVED_BY S19;
                        PREDICT NOMINAL: S19;  PREDICT F07: !S19; }
COMPONENT C04 BATTERY { MODES NOMINAL PRIOR 0; OBSERVED_BY S20; }

DERIVE S43 CAMERA_FAILED    = !MODE(C01) == NOMINAL | MODE(C05) == F05 | MODE(C06) == F02;
DERIVE S17 CAMERA_DEGRADED  = !S43 & (MODE(C08) == F04 | MODE(C07) == F03);
DERIVE S23 RADAR_AVAILABLE  = MODE(C02) == NOMINAL & S14;
DERIVE S42 TARGET_CONFIRMED = S16 & S18 & !S43;
DERIVE S41 TARGET_UNCERTAIN = S15 & !S42;

EVENT E07 CAMERA_BAD  = RISE S11;
EVENT E09 CONTACT     = RISE S15;
EVENT E10 BATTERY_LOW = RISE S20;

SYMBOL A00 SAFE_HOLD; SYMBOL A01 RETURN_STEP; SYMBOL A04 SWITCH_RADAR; SYMBOL A06 APPROACH;
SYMBOL A09 EXPLORE_STEP; SYMBOL A12 OBSERVE; SYMBOL A13 DECLARE;

BEHAVIOR B10 RETURN PRIORITY 10 {
    RULE R10 WHEN S20  DO A01;
}
BEHAVIOR B20 TARGET_CONFIRM PRIORITY 20 ENABLED_BY MISSION.GOAL == SEARCH {
    RULE R20 WHEN S42                          DO A13;
    RULE R21 WHEN !S42 & S41 & S16 & !S43      DO A12;
    RULE R22 WHEN !S42 & S41 & !S16 & S23      DO A06;
}
BEHAVIOR B25 DIAGNOSE PRIORITY 25 {
    RULE R26 ON E07 WHEN TRUE                  DO A12;
}
BEHAVIOR B30 SEARCH PRIORITY 30 ENABLED_BY MISSION.GOAL == SEARCH {
    RULE R30 WHEN S17 & S23 & !S42             DO A04;
}
BEHAVIOR B40 EXPLORE PRIORITY 40 {
    RULE R40 WHEN TRUE                         DO A09;
}

ARBITRATION B10 > B20 > B25 > B30 > B40;

SAFETY {
    VETO A06, A09, A01 WHEN S21  REASON HAZARD;
    VETO A06, A09      WHEN S20  REASON BATTERY_RESERVE;
    VETO A13           WHEN !S42 REASON NO_EVIDENCE;
    FALLBACK WHEN S20 & !S21 DO A01;
    FALLBACK WHEN TRUE       DO A00;
}

BUDGET RECONFIG TOKENS 2000;
COST A01 TOKENS RECONFIG WHEN S42;
